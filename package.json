{
  "name": "meeting-notes",
  "version": "2.0.0",
  "description": "회의를 녹음하면 OpenAI로 받아쓰고 결정 사항·할 일까지 정리해 주는 로컬 회의록 앱 (Windows · macOS)",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "start": "node scripts/launch.mjs",
    "stop": "node scripts/stop.mjs",
    "shortcut": "node scripts/create-shortcut.mjs",
    "build": "vite build",
    "typecheck": "tsc -b",
    "serve": "tsx server/index.ts",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsx watch server/index.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/static": "10.1.10",
    "@fastify/websocket": "11.3.0",
    "archiver": "8.0.0",
    "better-sqlite3": "12.11.1",
    "fastify": "5.12.8",
    "ffmpeg-static": "5.3.0",
    "open": "11.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tsx": "4.23.0",
    "ws": "8.21.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "8.0.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "10.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  },
  "overrides": {
    "fast-uri@3": "3.1.9",
    "fast-uri@4": "4.2.3",
    "readdir-glob": {
      "minimatch": "11.0.5"
    }
  }
}
